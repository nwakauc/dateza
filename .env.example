# Public frontend configuration only. Never put secrets here.
# Upstream D8N origin for the local Vite development proxy only.
# Browser code always calls same-origin `/api/*`; this value is never its
# browser-facing API base and is not required by a Vercel production build.
# Brand is resolved from the upstream host.
#
# Local (`npm run dev` on http://localhost:5173): DateZA staging API.
# Do not use http://dateza.test:3000 unless a local Rails API is running. Do not
# use http://localhost:3000 or https://staging-api.d8n.tech — those resolve to
# HookUs.
VITE_D8N_API_URL=https://dateza-staging-api.d8n.tech
