# Public frontend configuration only. Never put secrets here.
# D8N origin for this DateZA environment. Brand is resolved from this host.
# Required. Absolute http(s) URL, no trailing slash. Embedded at Vite build time.
#
# Local (`npm run dev` on http://localhost:5173): DateZA staging API.
# Backend CORS allows this frontend origin. Do not use http://dateza.test:3000
# unless a local Rails API is running. Do not use http://localhost:3000 or
# https://staging-api.d8n.tech — those resolve to HookUs.
VITE_D8N_API_URL=https://dateza-staging-api.d8n.tech
